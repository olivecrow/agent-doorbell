{
  "name": "agent-doorbell",
  "version": "1.0.0",
  "description": "A local CLI for AI agents to request human attention with speech and an offline notification sound fallback.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "doorbell": "./dist/cli.js",
    "doorbell-mcp": "./dist/mcp.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "2.23.0",
    "@inquirer/prompts": "8.7.2",
    "@modelcontextprotocol/server": "2.0.0",
    "execa": "10.0.1",
    "openai": "^7.15.0",
    "proper-lockfile": "4.1.2",
    "wavefile": "11.0.0",
    "write-file-atomic": "8.0.0",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "assets/notification.mp3",
    "assets/LICENSE.md",
    "docs/*.md",
    "plugins/doorbell/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olivecrow/agent-doorbell.git"
  },
  "homepage": "https://github.com/olivecrow/agent-doorbell#readme",
  "bugs": {
    "url": "https://github.com/olivecrow/agent-doorbell/issues"
  }
}
